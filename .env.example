# Версия PHP: php82 | php83 | php84 | php85
PHP_VERSION=php85

# Xdebug: включение/выключение (true/false)
XDEBUG_ENABLED=true
# Режимы Xdebug через запятую: off, develop, debug, coverage, profile, trace, gcstats
XDEBUG_MODE=debug,develop
# Идентификатор IDE для отладки (PhpStorm по умолчанию)
XDEBUG_IDEKEY=PHPSTORM

# Порт Redis на хосте (внутри Docker-сети — redis:6379)
REDIS_PORT=6379

DB_USERNAME=bitrix
DB_PASSWORD=FB0pr297)R{Env@
DB_DATABASE=bitrix_db
